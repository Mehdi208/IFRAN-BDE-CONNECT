
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fonction pour vérifier si l'utilisateur est authentifié via Firebase Auth
    function isAdmin() {
      return request.auth != null;
    }

    // --- RÈGLES PAR COLLECTION ---

    // 1. Membres du BDE
    match /members/{memberId} {
      allow read: if true;
      allow write: if isAdmin() || true; // Autorisé temporairement pour bypass local
    }

    // 2. Clubs permanents
    match /clubs/{clubId} {
      allow read: if true;
      allow write: if isAdmin() || true; // Autorisé temporairement
    }

    // 3. Ateliers (Afternoon Day Club)
    match /ateliers/{atelierId} {
      allow read: if true;
      allow write: if isAdmin() || true; // Autorisé temporairement
    }

    // 4. Événements
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin() || true; // Autorisé temporairement
    }

    // 5. Mentors / Tutorat
    match /mentors/{mentorId} {
      allow read: if true;
      allow write: if isAdmin() || true; // Autorisé temporairement
    }

    // 6. Produits de la Cantine (Menu)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || true; // Autorisé temporairement
    }

    // 7. Inscriptions aux Clubs/Ateliers
    match /club_registrations/{regId} {
      allow read, create: if true;
      allow update, delete: if isAdmin() || true; // Autorisé temporairement
    }

    // 8. Commandes de la Cantine
    match /food_orders/{orderId} {
      allow read, create: if true;
      allow update, delete: if isAdmin() || true; // Autorisé temporairement
    }

    // 9. Réservations Cinéma (et ventes)
    match /cinema_sales/{saleId} {
      allow read, create: if true;
      allow update, delete: if isAdmin() || true; // Autorisé temporairement
    }

    // 10. Étudiants (Cotisations)
    match /students/{studentId} {
      allow read, write: if isAdmin() || true; // Autorisé temporairement
    }

    // 11. Documents générés (Historique)
    match /documents/{docId} {
      allow read, write: if isAdmin() || true; // Autorisé temporairement
    }

    // 12. Galerie
    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin() || true; // Autorisé temporairement
    }

    // 13. Assinie Registrations
    match /assinie_registrations/{regId} {
      allow read, create: if true;
      allow update, delete: if isAdmin() || true; // Autorisé temporairement
    }

    // 14. Naza Registrations
    match /naza_registrations/{regId} {
      allow read, create: if true;
      allow update, delete: if isAdmin() || true; // Autorisé temporairement
    }

    // 15. Prospect Contacts (Prospection)
    match /prospect_contacts/{contactId} {
      allow read, write: if isAdmin() || true; // Autorisé temporairement
    }

    // 16. Campaign Templates
    match /campaign_templates/{templateId} {
      allow read, write: if isAdmin() || true; // Autorisé temporairement
    }

    // --- RÈGLE GLOBALE DE SÉCURITÉ ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
